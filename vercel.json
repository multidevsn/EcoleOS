{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/wave/*.ts": {
      "runtime": "nodejs24.x"
    },
    "api/onboarding/*.ts": {
      "runtime": "nodejs24.x"
    },
    "api/metrics/*.ts": {
      "runtime": "nodejs24.x"
    },
    "api/billing/*.ts": {
      "runtime": "nodejs24.x"
    },
    "api/admin/*.ts": {
      "runtime": "nodejs24.x"
    },
    "api/director/*.ts": {
      "runtime": "nodejs24.x"
    },
    "api/admin/security.ts": {
      "runtime": "nodejs24.x"
    }
  },
  "crons": [
    {
      "path": "/api/admin/provider-costs",
      "schedule": "50 1 * * *"
    },
    {
      "path": "/api/metrics/rollup",
      "schedule": "15 2 * * *"
    },
    {
      "path": "/api/billing/autopilot",
      "schedule": "30 2 * * *"
    }
  ]
}
