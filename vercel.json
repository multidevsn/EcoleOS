{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/wave/*.ts": { "memory": 1024 },
    "api/onboarding/*.ts": { "memory": 1024 },
    "api/metrics/*.ts": { "memory": 1024 },
    "api/billing/*.ts": { "memory": 1024 },
    "api/admin/*.ts": { "memory": 1024 },
    "api/director/*.ts": { "memory": 1024 },
    "api/admin/security.ts": { "memory": 1024 }
  },
  "crons": [
    {
      "path": "/api/admin/provider-costs",
      "schedule": "50 1 * * *"
    },
    {
      "path": "/api/metrics/rollup",
      "schedule": "15 2 * * *"
    },
    {
      "path": "/api/billing/autopilot",
      "schedule": "30 2 * * *"
    }
  ]
}
