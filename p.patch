+import {describe, expect, it} from 'vitest'
+import {buildPaymentReminders, paymentLink, reminderMessage} from '../server/reminders'
+import type {PaymentReminderInput} from '../server/reminders'
+import {localDay} from '../server/local-day'
+
+const day = (offset: number) => localDay(new Date(Date.now() + offset * 86_400_000))
+
+const base = (over: Partial<PaymentReminderInput> = {}): PaymentReminderInput => ({
+  payment_id: 'pay-1',
+  child_id: 'c1',
+  child_name: 'Awa Diop',
+  school_name: 'Lycée Horizon',
+  parent_id: 'p1',
+  description: 'Scolarité novembre',
+  amount_xof: 30000,
+  due_date: day(5),
+  status: 'pending',
+  ...over,
+})
+
+describe('buildPaymentReminders — sélection des relances', () => {
+  it('ne relance que les échéances non soldées', () => {
+    const rows = [
+      base({payment_id: 'pending', status: 'pending'}),
+      base({payment_id: 'paid', status: 'succeeded'}),
+      base({payment_id: 'expired', status: 'expired'}),
+    ]
+    const reminders = buildPaymentReminders(rows, 'https://ecole.example')
+    expect(reminders.map(r => r.payment_id)).toEqual(['pending'])
+  })
+
+  it('marque en retard une échéance dépassée et trie les arriérés en premier', () => {
+    const reminders = buildPaymentReminders([
+      base({payment_id: 'futur', due_date: day(10)}),
+      base({payment_id: 'retard', due_date: day(-8)}),
+    ], 'https://ecole.example')
+    expect(reminders[0].payment_id).toBe('retard')
+    expect(reminders[0].overdue).toBe(true)
+    expect(reminders[1].overdue).toBe(false)
+  })
+
+  it('attache un lien de paiement unique par échéance', () => {
+    const [reminder] = buildPaymentReminders([base()], 'https://ecole.example/')
+    expect(reminder.payment_link).toBe('https://ecole.example/payer/pay-1')
+  })
+})
+
+describe('reminderMessage — texte de l’alerte', () => {
+  it('mentionne le montant et le lien pour un arriéré', () => {
+    const [reminder] = buildPaymentReminders([base({due_date: day(-3)})], 'https://ecole.example')
+    const text = reminderMessage(reminder)
+    expect(text).toContain('arriérés')
+    expect(text).toContain('30')
+    expect(text).toContain('https://ecole.example/payer/pay-1')
+  })
+
+  it('parle d’échéance à venir quand la date n’est pas dépassée', () => {
+    const [reminder] = buildPaymentReminders([base({due_date: day(6)})], 'https://ecole.example')
+    expect(reminderMessage(reminder)).toContain('échéance')
+    expect(reminderMessage(reminder)).not.toContain('arriérés')
+  })
+})
+
+describe('paymentLink', () => {
+  it('normalise la base et encode l’identifiant', () => {
+    expect(paymentLink('https://ecole.example///', 'a b')).toBe('https://ecole.example/payer/a%20b')
+  })
+})
