+++ b/server/saspay.ts
@@ -0,0 +1,173 @@
+/**
+ * Adaptateur SasPay — encaissement de la scolarité par mobile money.
+ *
+ * Règles non négociables :
+ *  - aucune clé SasPay ne doit jamais apparaître dans une variable `VITE_*` : ce fichier
+ *    n'est exécuté que côté serveur (Vercel), les identifiants viennent de `process.env` ;
+ *  - si SasPay n'est pas configuré, on renvoie une erreur explicite en français plutôt
+ *    qu'un 500 opaque : l'interface la traduit via `describeError` ;
+ *  - la forme exacte de la requête/réponse doit être calée sur la documentation SasPay du
+ *    compte marchand. Elle est isolée ICI et seulement ici (`createSasPayCheckout`) : un
+ *    changement de contrat ne touche aucun autre fichier.
+ *
+ * Variables d'environnement attendues :
+ *   SASPAY_API_BASE      ex. https://api.saspay.example/v1  (obligatoire)
+ *   SASPAY_API_KEY       clé secrète du marchand            (obligatoire)
+ *   SASPAY_WEBHOOK_SECRET secret de signature des callbacks (obligatoire pour le webhook)
+ */
+import { env } from './env.js'
+
+export type SasPayMethod = 'wave' | 'orange_money'
+
+export const saspayMethodLabels: Record<SasPayMethod, string> = {
+  wave: 'Wave',
+  orange_money: 'Orange Money',
+}
+
+/** Accepte uniquement 'wave' et 'orange_money' : rien d'autre ne part chez le prestataire. */
+export function normalizeSasPayMethod(value: unknown): SasPayMethod | null {
+  const raw = String(value ?? '').trim().toLowerCase()
+  if (raw === 'wave' || raw === 'orange_money' || raw === 'orange money' || raw === 'om') return raw === 'wave' ? 'wave' : 'orange_money'
+  return null
+}
+
+/**
+ * Normalise un numéro mobile sénégalais en E.164 (+221…).
+ * Jumeau serveur de `normalizeSenegalPhone` (src/appModel.ts) : le bundle serverless
+ * n'importe pas le code client, la règle est donc dupliquée volontairement.
+ */
+export function normalizeSenegalPhone(raw: string): string | null {
+  const digits = String(raw || '').replace(/[^\d+]/g, '')
+  if (!digits) return null
+  if (digits.startsWith('+221')) return digits.length === 13 ? digits : null
+  const national = digits.replace(/^00221/, '').replace(/^221/, '').replace(/^0/, '')
+  if (national.length !== 9 || !/^7\d{8}$/.test(national)) return null
+  return `+221${national}`
+}
+
+export function saspayConfigured(): boolean {
+  return Boolean(env('SASPAY_API_BASE') && env('SASPAY_API_KEY'))
+}
+
+export function saspayConfigError(): string | null {
+  const missing = [
+    env('SASPAY_API_BASE') ? null : 'SASPAY_API_BASE',
+    env('SASPAY_API_KEY') ? null : 'SASPAY_API_KEY',
+  ].filter(Boolean)
+  if (!missing.length) return null
+  return `SasPay n’est pas encore activé sur ce serveur (manque ${missing.join(', ')}). Aucun débit n’a été effectué.`
+}
+
+export interface SasPayCheckoutResult {
+  /** URL de validation à ouvrir, si SasPay renvoie une page/USSD. */
+  redirect_url: string | null
+  checkout_id: string
+  reference: string
+  /** Message à afficher quand aucune redirection n'est nécessaire (push sur le téléphone). */
+  message: string | null
+}
+
+/** Traduit un échec SasPay en message compréhensible pour une famille. */
+export function describeSasPayError(status: number, payload: any): string {
+  const detail = String(payload?.message || payload?.error || '').trim()
+  if (status === 401 || status === 403) return 'Le serveur n’a pas pu s’authentifier auprès de SasPay. Réessayez plus tard ou prévenez l’établissement.'
+  if (status === 402) return 'Le paiement a été refusé par l’opérateur. Vérifiez votre solde ou changez de moyen de paiement.'
+  if (status === 404) return 'SasPay n’a pas reconnu cette demande de paiement. Réessayez depuis l’espace parent.'
+  if (status === 409) return 'Une transaction est déjà en cours pour cette échéance. Attendez sa confirmation avant de réessayer.'
+  if (status === 422) return detail || 'Le numéro ou le montant a été rejeté par SasPay. Vérifiez le numéro saisi.'
+  if (status === 429) return 'Trop de tentatives : patientez une minute avant de réessayer.'
+  if (status >= 500) return 'SasPay est momentanément indisponible. Aucun débit n’a été effectué : réessayez dans quelques minutes.'
+  return detail || 'Le paiement n’a pas pu être créé.'
+}
+
+/**
+ * Crée une demande d'encaissement SasPay.
+ * Lève une erreur dont le message est déjà présentable à l'utilisateur.
+ */
+export async function createSasPayCheckout(input: {
+  amount_xof: number
+  reference: string
+  method: SasPayMethod
+  phone: string
+  returnUrl: string
+}): Promise<SasPayCheckoutResult> {
+  const amount = Math.round(Number(input.amount_xof) || 0)
+  if (amount <= 0) throw new Error('Montant invalide : aucune échéance à régler.')
+  const phone = normalizeSenegalPhone(input.phone)
+  if (!phone) throw new Error('Numéro invalide : saisissez un mobile sénégalais à 9 chiffres.')
+
+  const base = String(env('SASPAY_API_BASE') || '').replace(/\/+$/, '')
+  const response = await fetch(`${base}/collections`, {
+    method: 'POST',
+    headers: {
+      Authorization: `Bearer ${env('SASPAY_API_KEY')}`,
+      'Content-Type': 'application/json',
+      'Idempotency-Key': input.reference,
+    },
+    body: JSON.stringify({
+      amount,
+      currency: 'XOF',
+      provider: input.method,
+      payer_msisdn: phone,
+      reference: input.reference,
+      description: `Scolarité — ${input.reference}`,
+      callback_url: input.returnUrl,
+    }),
+  })
+
+  let payload: any = null
+  try {
+    payload = await response.json()
+  } catch {
+    payload = null
+  }
+  if (!response.ok) {
+    const error = new Error(describeSasPayError(response.status, payload)) as Error & { status?: number }
+    error.status = response.status
+    throw error
+  }
+
+  const checkoutId = String(payload?.id || payload?.data?.id || payload?.transaction_id || '')
+  if (!checkoutId) throw new Error('SasPay n’a pas renvoyé de référence de transaction. Aucun débit confirmé.')
+  return {
+    redirect_url: String(payload?.redirect_url || payload?.data?.redirect_url || payload?.authorization_url || '') || null,
+    checkout_id: checkoutId,
+    reference: input.reference,
+    message: String(payload?.message || '') || null,
+  }
+}
+
+function bytesToHex(bytes: Uint8Array): string {
+  return Array.from(bytes, byte => byte.toString(16).padStart(2, '0')).join('')
+}
+
+function constantTimeHexEqual(a: string, b: string): boolean {
+  if (a.length !== b.length) return false
+  let diff = 0
+  for (let i = 0; i < a.length; i++) diff |= a.charCodeAt(i) ^ b.charCodeAt(i)
+  return diff === 0
+}
+
+/**
+ * Vérifie la signature d'un callback SasPay (format `t=<unix>,v1=<hmac-sha256>`).
+ * Un horodatage de plus de 5 minutes est rejeté (rejeu).
+ */
+export async function verifySasPaySignature(rawBody: string, header: string, secret?: string): Promise<boolean> {
+  const signingSecret = secret || env('SASPAY_WEBHOOK_SECRET')
+  if (!signingSecret) return false
+  const match = String(header || '').match(/t=(\d+),v1=([a-f0-9]+)/)
+  if (!match) return false
+  const timestamp = Number(match[1])
+  if (!Number.isFinite(timestamp) || Math.abs(Date.now() / 1000 - timestamp) > 300) return false
+  const key = await crypto.subtle.importKey('raw', new TextEncoder().encode(signingSecret), { name: 'HMAC', hash: 'SHA-256' }, false, ['sign'])
+  const signature = await crypto.subtle.sign('HMAC', key, new TextEncoder().encode(String(timestamp) + rawBody))
+  return constantTimeHexEqual(bytesToHex(new Uint8Array(signature)), match[2])
+}
+
+/** État d'un événement SasPay, quel que soit le nom de champ retenu par le prestataire. */
+export function saspayEventStatus(event: any): 'succeeded' | 'failed' | 'pending' {
+  const raw = String(event?.status || event?.data?.status || event?.payment_status || event?.data?.payment_status || '').toLowerCase()
+  if (['succeeded', 'success', 'paid', 'completed'].includes(raw)) return 'succeeded'
+  if (['failed', 'failure', 'cancelled', 'canceled', 'expired'].includes(raw)) return 'failed'
+  return 'pending'
+}
