+/** @vitest-environment jsdom */
+import React from 'react'
+import {cleanup, fireEvent, render, screen, waitFor} from '@testing-library/react'
+import {afterEach, describe, expect, it} from 'vitest'
+import {ParentSpace, activeChildOf} from '../src/screens-parent'
+import {createDemoData} from '../src/demoFixtures'
+
+// Sans `globals: true` dans la config Vitest, React Testing Library ne nettoie pas
+// automatiquement le DOM entre deux tests : le cleanup est donc explicite.
+afterEach(cleanup)
+
+function renderParent(childId?: string | null) {
+  const data = createDemoData('parent', childId)
+  render(<ParentSpace mode="demo" data={data} session={null} />)
+  return data
+}
+
+describe('Espace parent — enfant suivi', () => {
+  it('affiche l’enfant sélectionné, sa classe et son établissement', () => {
+    renderParent('demo-child-aissatou')
+    expect(screen.getByRole('heading', {level: 1}).textContent).toContain('Aïssatou Ndiaye')
+    expect(screen.getByText(/6e A/)).toBeTruthy()
+    expect(screen.getByText(/École Démo Horizon/)).toBeTruthy()
+  })
+
+  it('change de contenu quand on bascule sur un autre enfant, sans changer de compte', () => {
+    const data = createDemoData('parent', 'demo-child-cheikh')
+    expect(activeChildOf(data)?.full_name).toBe('Cheikh Ndiaye')
+    render(<ParentSpace mode="demo" data={data} session={null} />)
+    expect(screen.getByRole('heading', {level: 1}).textContent).toContain('Cheikh Ndiaye')
+    // Enfant scolarisé dans un AUTRE établissement : le compte parent reste le même.
+    expect(screen.getByText(/Institut Sainte-Marie/)).toBeTruthy()
+  })
+
+  it('retombe sur le premier enfant quand aucune sélection n’est faite', () => {
+    const data = createDemoData('parent', null)
+    expect(activeChildOf(data)?.id).toBe('demo-child-amadou')
+  })
+})
+
+describe('Espace parent — trésorerie', () => {
+  it('signale les arriérés d’un enfant en retard', () => {
+    renderParent('demo-child-aissatou')
+    expect(screen.getAllByText(/Arriérés à régulariser/).length).toBeGreaterThan(0)
+    expect(screen.getAllByText(/À régulariser/).length).toBeGreaterThan(0)
+  })
+
+  it('refuse un numéro invalide avant toute demande de paiement', async () => {
+    renderParent('demo-child-aissatou')
+    fireEvent.click(screen.getByRole('button', {name: /Orange Money/}))
+    fireEvent.change(screen.getByLabelText('Numéro Orange Money'), {target: {value: '12345'}})
+    fireEvent.click(screen.getByRole('button', {name: /Payer .* avec Orange Money/}))
+
+    await waitFor(() => expect(screen.getByText(/Numéro invalide/)).toBeTruthy())
+    expect(screen.queryByText(/Paiement simulé/)).toBeNull()
+  })
+
+  it('produit un reçu simulé avec un numéro valide, sans appel réseau', async () => {
+    renderParent('demo-child-aissatou')
+    fireEvent.click(screen.getByRole('button', {name: /Orange Money/}))
+    fireEvent.change(screen.getByLabelText('Numéro Orange Money'), {target: {value: '77 123 45 67'}})
+    fireEvent.click(screen.getByRole('button', {name: /Payer .* avec Orange Money/}))
+
+    await waitFor(() => expect(screen.getByText(/Paiement simulé : aucun débit réel/)).toBeTruthy())
+    expect(screen.getByText(/Reçu DEMO-/)).toBeTruthy()
+  })
+
+  it('n’affiche aucune échéance à payer quand la scolarité est réglée', () => {
+    const data = createDemoData('parent', 'demo-child-cheikh')
+    data.payments = data.payments.filter(payment => payment.status === 'succeeded')
+    render(<ParentSpace mode="demo" data={data} session={null} />)
+    expect(screen.getByText(/Scolarité à jour/)).toBeTruthy()
+    // Le bandeau ET l'échéancier vide le disent : les deux occurrences sont attendues.
+    expect(screen.getAllByText(/Aucune échéance en attente/).length).toBeGreaterThanOrEqual(2)
+  })
+})
+
+describe('Espace parent — suivi pédagogique', () => {
+  it('liste le cahier de textes de l’enfant suivi', () => {
+    renderParent('demo-child-aissatou')
+    expect(screen.getByText('Rédaction : raconter une scène de marché')).toBeTruthy()
+  })
+
+  it('montre une absence signalée à l’appel', () => {
+    renderParent('demo-child-aissatou')
+    expect(screen.getAllByText('Absent').length).toBeGreaterThan(0)
+    expect(screen.getByText(/dès qu’un agent saisit une absence/)).toBeTruthy()
+  })
+
+  it('ne mélange pas les devoirs d’un autre enfant', () => {
+    renderParent('demo-child-aissatou')
+    expect(screen.queryByText('Exercices 4 à 8, page 122')).toBeNull()
+  })
+})
diff --git a/tests/receipt-pdf.test.ts b/tests/receipt-pdf.test.ts
new file mode 100644
index 0000000..50153cc
--- /dev/null
+++ b/tests/receipt-pdf.test.ts
@@ -0,0 +1,79 @@
+import {describe, expect, it} from 'vitest'
+import {buildReceiptPdf, formatXof} from '../server/receipt-pdf'
+
+const input = {
+  title: 'Reçu de paiement — scolarité',
+  subtitle: 'Lycée Horizon Dakar',
+  reference: 'REC-2026-00A1B2',
+  amountLabel: `Montant réglé : ${formatXof(45000)}`,
+  lines: [
+    {label: 'Élève', value: 'Amadou Ndiaye'},
+    {label: 'Classe', value: 'Terminale S2'},
+    {label: 'Échéance', value: 'Scolarité novembre'},
+  ],
+  footer: 'Conservez ce reçu : il fait foi auprès de l’administration.',
+}
+
+/** Décode le PDF en Latin-1 : c'est l'encodage réel des octets produits. */
+function latin1(bytes: Uint8Array): string {
+  let out = ''
+  for (const byte of bytes) out += String.fromCharCode(byte)
+  return out
+}
+
+describe('buildReceiptPdf — reçu PDF généré côté serveur', () => {
+  it('produit un en-tête et une fin de fichier PDF valides', () => {
+    const text = latin1(buildReceiptPdf(input))
+    expect(text.startsWith('%PDF-1.4')).toBe(true)
+    expect(text.trimEnd().endsWith('%%EOF')).toBe(true)
+    expect(text).toContain('xref')
+    expect(text).toContain('startxref')
+  })
+
+  it('pointe une table xref dont chaque offset vise bien un objet', () => {
+    const text = latin1(buildReceiptPdf(input))
+    const startxref = Number(/startxref\n(\d+)\n/.exec(text)?.[1])
+    expect(Number.isFinite(startxref)).toBe(true)
+    expect(text.slice(startxref, startxref + 4)).toBe('xref')
+
+    const entries = [...text.slice(startxref).matchAll(/^(\d{10}) (\d{5}) n $/gm)]
+    expect(entries.length).toBe(6)
+    entries.forEach((entry, index) => {
+      const offset = Number(entry[1])
+      expect(text.slice(offset, offset + `${index + 1} 0 obj`.length)).toBe(`${index + 1} 0 obj`)
+    })
+  })
+
+  it('contient la référence, le montant et l’élève du reçu', () => {
+    const text = latin1(buildReceiptPdf(input))
+    expect(text).toContain('REC-2026-00A1B2')
+    expect(text).toContain('Amadou Ndiaye')
+    expect(text).toContain('45')
+    expect(text).toContain('Helvetica-Bold')
+  })
+
+  it('conserve les accents français en WinAnsi et échappe les parenthèses', () => {
+    const bytes = buildReceiptPdf({...input, lines: [{label: 'Élève (officiel)', value: 'Ndiaye'}]})
+    // « É » = 0xC9 en WinAnsi ; une parenthèse non échappée casserait la chaîne PDF.
+    expect(bytes.some(byte => byte === 0xc9)).toBe(true)
+    expect(latin1(bytes)).toContain('\\(officiel\\)')
+  })
+
+  it('ne laisse aucun caractère hors WinAnsi dans le fichier', () => {
+    const bytes = buildReceiptPdf({...input, subtitle: 'École “Horizon” — Dakar'})
+    for (const byte of bytes) expect(byte).toBeLessThanOrEqual(0xff)
+    expect(latin1(bytes)).not.toContain('“')
+  })
+  it('imprime les montants sans transformer l’espace de millier en « ? »', () => {
+    const text = latin1(buildReceiptPdf({...input, amountLabel: `Montant réglé : ${formatXof(45000)}`}))
+    expect(text).not.toContain('?000')
+    expect(text).toMatch(/45[\s\u00a0]000 FCFA/)
+  })
+})
+
+describe('formatXof', () => {
+  it('formate en francs CFA', () => {
+    expect(formatXof(45000)).toMatch(/^45\s*000 FCFA$/)
+    expect(formatXof(0)).toBe('0 FCFA')
+  })
+})
