diff --git a/api/saspay/checkout.ts b/api/saspay/checkout.ts
new file mode 100644
index 0000000..a788f2d
--- /dev/null
+++ b/api/saspay/checkout.ts
@@ -0,0 +1,100 @@
+import { env } from '../../server/env.js'
+import type { VercelRequest, VercelResponse } from '@vercel/node'
+import { createClient } from '@supabase/supabase-js'
+
+import { withSecurity } from '../../server/security.js'
+import { createSasPayCheckout, normalizeSasPayMethod, normalizeSenegalPhone, saspayConfigError } from '../../server/saspay.js'
+import { appUrl, bestEffort, findPayablePayment } from '../../server/school-payments.js'
+
+function json(res: VercelResponse, status: number, body: unknown) {
+  return res.status(status).json(body)
+}
+
+/**
+ * POST /api/saspay/checkout
+ * Crée une demande d'encaissement SasPay (Wave ou Orange Money) pour une échéance
+ * scolaire. Le parent paie pour un enfant rattaché à son compte : la vérification
+ * d'appartenance est faite côté serveur via `parent_students`.
+ */
+async function handler(req: VercelRequest, res: VercelResponse) {
+  if (req.method !== 'POST') return json(res, 405, {error: 'Method not allowed'})
+
+  const configError = saspayConfigError()
+  if (configError) return json(res, 503, {error: configError})
+  if (!env('SUPABASE_URL') || !env('SUPABASE_PUBLISHABLE_KEY') || !env('SUPABASE_SECRET_KEY')) {
+    return json(res, 503, {error: 'Supabase serveur non configuré : renseigne SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY et SUPABASE_SECRET_KEY.'})
+  }
+
+  const auth = String(req.headers.authorization || '')
+  const token = auth.startsWith('Bearer ') ? auth.slice(7) : ''
+  if (!token) return json(res, 401, {error: 'Authentification requise.'})
+
+  const method = normalizeSasPayMethod(req.body?.method)
+  if (!method) return json(res, 400, {error: 'Moyen de paiement invalide : Wave ou Orange Money.'})
+  const phone = normalizeSenegalPhone(String(req.body?.phone || ''))
+  if (!phone) return json(res, 400, {error: 'Numéro invalide : saisissez un mobile sénégalais à 9 chiffres.'})
+  const paymentId = String(req.body?.payment_id || '')
+  if (!paymentId) return json(res, 400, {error: 'Échéance manquante.'})
+
+  try {
+    const userClient = createClient(env('SUPABASE_URL'), env('SUPABASE_PUBLISHABLE_KEY'), {global: {headers: {Authorization: `Bearer ${token}`}}})
+    const admin = createClient(env('SUPABASE_URL'), env('SUPABASE_SECRET_KEY'))
+    const {data: {user}, error: userError} = await userClient.auth.getUser(token)
+    if (userError || !user) return json(res, 401, {error: 'Session invalide ou expirée.'})
+
+    const access = await findPayablePayment(admin, user.id, paymentId)
+    if (!access) return json(res, 403, {error: 'Échéance introuvable, ou rattachée à un autre enfant.'})
+    if (access.payment.status === 'succeeded') return json(res, 409, {error: 'Cette échéance est déjà réglée : téléchargez le reçu.'})
+    if (access.payment.status !== 'pending') return json(res, 409, {error: 'Cette échéance n’est plus payable.'})
+
+    const reference = `school-payment:${access.payment.id}`
+    const result = await createSasPayCheckout({
+      amount_xof: access.payment.amount_xof,
+      reference,
+      method,
+      phone,
+      returnUrl: `${appUrl(req.headers.host as string | undefined)}/?payment=success`,
+    })
+
+    // La colonne vient de la migration « espace parent » : si elle manque sur cette base,
+    // on ne bloque pas le paiement du parent pour autant.
+    // Le numéro du parent n'est volontairement PAS conservé : il ne sert qu'à initier la
+    // transaction chez SasPay. On ne garde que la référence et le moyen de paiement.
+    await bestEffort(
+      admin
+        .from('school_payments')
+        .update({saspay_checkout_id: result.checkout_id, saspay_method: method})
+        .eq('id', access.payment.id),
+    )
+
+    // Journal Transactions (migration « Ecole.Online ») : une ligne par tentative,
+    // mise à jour en « succeeded » par le webhook quand SasPay confirme.
+    await bestEffort(
+      admin
+        .from('transactions')
+        .insert({
+          payment_id: access.payment.id,
+          child_id: access.payment.user_id,
+          payer_id: user.id,
+          method,
+          provider: 'saspay',
+          provider_checkout_id: result.checkout_id,
+          amount_xof: access.payment.amount_xof,
+          status: 'initiated',
+        }),
+    )
+
+    return json(res, 200, {
+      redirect_url: result.redirect_url,
+      checkout_id: result.checkout_id,
+      reference,
+      message: result.message,
+      amount_xof: access.payment.amount_xof,
+    })
+  } catch (error: any) {
+    const status = Number(error?.status) || 502
+    return json(res, status >= 400 && status < 600 ? status : 502, {error: error?.message || 'Le paiement SasPay n’a pas pu être créé.'})
+  }
+}
+
+export default withSecurity('/api/saspay/checkout', handler)
