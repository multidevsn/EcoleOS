+import {describe, expect, it} from 'vitest'
+import {buildSimenRows, SIMEN_COLUMNS, simenCsv, toSimenRow} from '../server/simen'
+
+describe('toSimenRow — normalisation au modèle ministériel', () => {
+  it('met noms et IEN en majuscules', () => {
+    const row = toSimenRow({ien_etablissement: 'dkr-0145', code_eleve: 'ELV-1', nom_prenoms: 'awa diop', classe: '6e A', moyenne: 12.5, absences: 2, retards: 1})
+    expect(row.IEN_ETABLISSEMENT).toBe('DKR-0145')
+    expect(row.NOM_PRENOMS).toBe('AWA DIOP')
+    expect(row.STATUT).toBe('INSCRIT')
+  })
+
+  it('formate la moyenne sur 20 à deux décimales avec virgule', () => {
+    expect(toSimenRow({ien_etablissement: 'X', code_eleve: null, nom_prenoms: 'a', classe: null, moyenne: 12.5, absences: 0, retards: 0}).MOYENNE_T1).toBe('12,50')
+    expect(toSimenRow({ien_etablissement: 'X', code_eleve: null, nom_prenoms: 'a', classe: null, moyenne: null, absences: 0, retards: 0}).MOYENNE_T1).toBe('')
+  })
+
+  it('plancher à zéro les compteurs de présence', () => {
+    const row = toSimenRow({ien_etablissement: 'X', code_eleve: null, nom_prenoms: 'a', classe: null, moyenne: null, absences: -3, retards: 2.6})
+    expect(row.NB_ABSENCES).toBe('0')
+    expect(row.NB_RETARDS).toBe('3')
+  })
+})
+
+describe('buildSimenRows — tri alphabétique', () => {
+  it('trie par nom (ordre français)', () => {
+    const rows = buildSimenRows([
+      {ien_etablissement: 'X', code_eleve: null, nom_prenoms: 'Zola', classe: null, moyenne: null, absences: 0, retards: 0},
+      {ien_etablissement: 'X', code_eleve: null, nom_prenoms: 'Alpha', classe: null, moyenne: null, absences: 0, retards: 0},
+    ])
+    expect(rows.map(r => r.NOM_PRENOMS)).toEqual(['ALPHA', 'ZOLA'])
+  })
+})
+
+describe('simenCsv — CSV ; ouvrable dans Excel', () => {
+  it('écrit l’en-tête dans l’ordre des colonnes officielles', () => {
+    const csv = simenCsv([])
+    expect(csv.split('\r\n')[0]).toBe(SIMEN_COLUMNS.join(';'))
+  })
+
+  it('échappe séparateur, guillemets et retours de ligne', () => {
+    const csv = simenCsv([toSimenRow({ien_etablissement: 'X', code_eleve: 'a;b', nom_prenoms: 'Ndiaye, "Awa"', classe: 'l1\nl2', moyenne: null, absences: 0, retards: 0})])
+    expect(csv).toContain('"a;b"')
+    expect(csv).toContain('"NDIAYE, ""AWA"""')
+    expect(csv).toContain('"l1\nl2"')
+  })
+})
