+/** @vitest-environment jsdom */
+import React from 'react'
+import {cleanup, fireEvent, render, screen, waitFor} from '@testing-library/react'
+import {afterEach, beforeEach, describe, expect, it, vi} from 'vitest'
+import {Community} from '../src/screens-engagement'
+import type {Profile} from '../src/appModel'
+
+const {supabaseModuleLoads, supabaseRpc} = vi.hoisted(() => ({
+  supabaseModuleLoads: vi.fn(),
+  supabaseRpc: vi.fn(),
+}))
+vi.mock('../src/lib/supabase', () => {
+  supabaseModuleLoads()
+  return {supabase: {rpc: supabaseRpc, from: vi.fn()}}
+})
+
+const student: Profile = {id: 'p-1', full_name: 'Awa Diop', role: 'student', email: 'awa@example.sn', class_name: '4e B'}
+
+function renderCommunity() {
+  return render(<Community role="student" mode="demo" session={null} profile={student} schoolId={null} />)
+}
+
+describe('Signalement d’un message (Communauté)', () => {
+  let prompt: ReturnType<typeof vi.fn>
+
+  beforeEach(() => {
+    localStorage.clear()
+    sessionStorage.clear()
+    supabaseModuleLoads.mockClear()
+    supabaseRpc.mockClear()
+    // window.prompt n’existe pas dans la WebView Android sans onJsPrompt : le signalement
+    // doit fonctionner sans lui.
+    prompt = vi.fn(() => 'motif tapé dans un prompt')
+    vi.stubGlobal('prompt', prompt)
+  })
+
+  afterEach(() => {
+    cleanup()
+    vi.unstubAllGlobals()
+  })
+
+  it('ouvre un formulaire intégré au lieu d’un window.prompt', async () => {
+    renderCommunity()
+
+    const flags = await screen.findAllByLabelText('Signaler ce message')
+    fireEvent.click(flags[0])
+
+    expect(prompt).not.toHaveBeenCalled()
+    expect(screen.getByLabelText('Motif du signalement')).toBeTruthy()
+    const submit = screen.getByRole('button', {name: 'Envoyer le signalement'}) as HTMLButtonElement
+    expect(submit.disabled).toBe(true)
+  })
+
+  it('envoie un motif choisi dans l’app, sans aucune requête backend en démo', async () => {
+    renderCommunity()
+
+    fireEvent.click((await screen.findAllByLabelText('Signaler ce message'))[0])
+    fireEvent.click(screen.getByRole('button', {name: 'Propos irrespectueux'}))
+
+    const submit = screen.getByRole('button', {name: 'Envoyer le signalement'}) as HTMLButtonElement
+    expect(submit.disabled).toBe(false)
+    fireEvent.click(submit)
+
+    await waitFor(() => expect(screen.getByText(/Signalement démo enregistré localement/)).toBeTruthy())
+    expect(prompt).not.toHaveBeenCalled()
+    expect(supabaseModuleLoads).not.toHaveBeenCalled()
+    expect(supabaseRpc).not.toHaveBeenCalled()
+    // Le panneau se referme après l’envoi.
+    expect(screen.queryByLabelText('Motif du signalement')).toBeNull()
+  })
+
+  it('annule le signalement sans rien enregistrer', async () => {
+    renderCommunity()
+
+    fireEvent.click((await screen.findAllByLabelText('Signaler ce message'))[0])
+    fireEvent.click(screen.getByRole('button', {name: 'Annuler'}))
+
+    await waitFor(() => expect(screen.queryByLabelText('Motif du signalement')).toBeNull())
+    expect(supabaseRpc).not.toHaveBeenCalled()
+    expect(screen.queryByText(/Signalement démo enregistré localement/)).toBeNull()
+  })
+})
