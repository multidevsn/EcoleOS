+    foodItems: foodRoles.includes(role) ? DEMO_FOOD_ITEMS.map(item => ({...item})) : [],
+    orders: orderRoles.includes(role) ? ownOrders : [],
+    rewards: demoRewards.map(reward => ({...reward})),
