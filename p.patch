+/**
+ * `YYYY-MM-DD` en heure locale. Jumeau serveur de `localDay` (src/appModel.ts) : le
+ * bundle serverless n'importe pas le code client, la règle est donc dupliquée.
+ */
+export function localDay(date = new Date()): string {
+  return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`
+}
