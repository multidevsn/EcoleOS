+import { buildReceiptPdf, formatXof } from '../../server/receipt-pdf.js'
+import { bestEffort, findPayablePayment, receiptReference } from '../../server/school-payments.js'
+
+function json(res: VercelResponse, status: number, body: unknown) {
+  return res.status(status).json(body)
+}
+
+/**
+ * GET /api/saspay/receipt?payment_id=…
+ * Reçu PDF d'une échéance réglée. Généré à la demande (aucun fichier stocké) et
+ * strictement réservé à l'élève concerné ou à un parent rattaché.
+ */
+async function handler(req: VercelRequest, res: VercelResponse) {
+  if (req.method !== 'GET') return json(res, 405, {error: 'Method not allowed'})
+  if (!env('SUPABASE_URL') || !env('SUPABASE_PUBLISHABLE_KEY') || !env('SUPABASE_SECRET_KEY')) {
+    return json(res, 503, {error: 'Supabase serveur non configuré.'})
+  }
+
+  const auth = String(req.headers.authorization || '')
+  const token = auth.startsWith('Bearer ') ? auth.slice(7) : ''
+  if (!token) return json(res, 401, {error: 'Authentification requise.'})
+
+  const query = (req.query || {}) as Record<string, string | string[]>
+  const paymentId = String(Array.isArray(query.payment_id) ? query.payment_id[0] : query.payment_id || '')
+  if (!paymentId) return json(res, 400, {error: 'Échéance manquante.'})
+
+  try {
+    const userClient = createClient(env('SUPABASE_URL'), env('SUPABASE_PUBLISHABLE_KEY'), {global: {headers: {Authorization: `Bearer ${token}`}}})
+    const admin = createClient(env('SUPABASE_URL'), env('SUPABASE_SECRET_KEY'))
+    const {data: {user}, error: userError} = await userClient.auth.getUser(token)
+    if (userError || !user) return json(res, 401, {error: 'Session invalide ou expirée.'})
+
+    const access = await findPayablePayment(admin, user.id, paymentId)
+    if (!access) return json(res, 403, {error: 'Reçu indisponible : cette échéance n’est pas rattachée à votre compte.'})
+    if (access.payment.status !== 'succeeded') {
+      return json(res, 409, {error: 'Reçu indisponible : cette échéance n’est pas encore réglée.'})
+    }
+
+    const reference = receiptReference(access.payment.id)
+    const pdf = buildReceiptPdf({
+      title: 'Reçu de paiement — scolarité',
+      subtitle: access.child?.school_name || 'Établissement',
+      reference,
+      amountLabel: `Montant réglé : ${formatXof(access.payment.amount_xof)}`,
+      lines: [
+        {label: 'Élève', value: access.child?.full_name || '—'},
+        {label: 'Classe', value: access.child?.class_name || '—'},
+        {label: 'Établissement', value: access.child?.school_name || '—'},
+        {label: 'Échéance', value: access.payment.description},
+        {label: 'Période', value: access.payment.due_date || '—'},
+        {label: 'Payeur', value: access.asParent ? 'Parent (compte rattaché)' : 'Élève'},
+        {label: 'Statut', value: 'Payé'},
+      ],
+      footer: 'Conservez ce reçu : il fait foi auprès de l’administration de l’établissement.',
+    })
+
+    // Journal d'audit : une ligne par reçu délivré. Tolérant aux bases où la table
+    // (migration « espace parent ») n'est pas encore créée.
+    await bestEffort(
+      admin
+        .from('payment_receipts')
+        .insert({payment_id: access.payment.id, reference, issued_to: user.id, amount_xof: access.payment.amount_xof}),
+    )
+
+    res.setHeader('Content-Type', 'application/pdf')
+    res.setHeader('Cache-Control', 'no-store')
+    res.setHeader('Content-Disposition', `inline; filename="${reference}.pdf"`)
+    res.setHeader('Content-Length', String(pdf.byteLength))
+    return res.status(200).end(Buffer.from(pdf))
+  } catch (error: any) {
+    return json(res, 500, {error: error?.message || 'Le reçu n’a pas pu être généré.'})
+  }
+}
+
+export default withSecurity('/api/saspay/receipt', handler)
diff --git a/api/saspay/webhook.ts b/api/saspay/webhook.ts
new file mode 100644
index 0000000..d45b1a6
--- /dev/null
+++ b/api/saspay/webhook.ts
@@ -0,0 +1,128 @@
+import { env } from '../../server/env.js'
+import type { VercelRequest, VercelResponse } from '@vercel/node'
+import { createClient } from '@supabase/supabase-js'
+
+import { withSecurity } from '../../server/security.js'
+import { saspayEventStatus, verifySasPaySignature } from '../../server/saspay.js'
+import { bestEffort, loadChild, receiptReference } from '../../server/school-payments.js'
+
+export const config = {api: {bodyParser: false}}
+
+async function rawBody(req: VercelRequest): Promise<string> {
+  const chunks: Uint8Array[] = []
+  for await (const chunk of req as AsyncIterable<Uint8Array | string>) {
+    chunks.push(typeof chunk === 'string' ? new TextEncoder().encode(chunk) : new Uint8Array(chunk))
+  }
+  const total = chunks.reduce((sum, chunk) => sum + chunk.byteLength, 0)
+  const merged = new Uint8Array(total)
+  let offset = 0
+  for (const chunk of chunks) {
+    merged.set(chunk, offset)
+    offset += chunk.byteLength
+  }
+  return new TextDecoder().decode(merged)
+}
+
+/**
+ * POST /api/saspay/webhook
+ * Callback prestataire : marque l'échéance comme réglée dès que SasPay confirme.
+ * Signature HMAC vérifiée, horodatage borné à 5 minutes, événement rejouable ignoré.
+ */
+async function handler(req: VercelRequest, res: VercelResponse) {
+  if (req.method !== 'POST') return res.status(405).end()
+  if (!env('SASPAY_WEBHOOK_SECRET')) return res.status(503).json({error: 'SASPAY_WEBHOOK_SECRET non configuré.'})
+
+  const body = await rawBody(req)
+  const signature = String(req.headers['saspay-signature'] || req.headers['x-saspay-signature'] || '')
+  if (!(await verifySasPaySignature(body, signature))) return res.status(401).json({error: 'Invalid signature'})
+
+  let event: any
+  try {
+    event = JSON.parse(body)
+  } catch {
+    return res.status(400).json({error: 'Invalid JSON'})
+  }
+
+  if (!env('SUPABASE_URL') || !env('SUPABASE_SECRET_KEY')) return res.status(503).json({error: 'Supabase secret server key non configurée.'})
+  const admin = createClient(env('SUPABASE_URL'), env('SUPABASE_SECRET_KEY'))
+
+  try {
+    const eventId = String(event.id || event.event_id || '')
+    if (eventId) {
+      // Idempotence : le même callback SasPay ne doit pas être appliqué deux fois.
+      const {data: existing} = await admin.from('saspay_events').select('id').eq('id', eventId).maybeSingle()
+      if (existing) return res.status(200).json({received: true, event_id: eventId, duplicate: true})
+      await bestEffort(
+        admin
+          .from('saspay_events')
+          .insert({id: eventId, event_type: String(event.type || event.event || 'unknown'), payload: event}),
+      )
+    }
+
+    const status = saspayEventStatus(event)
+    const reference = String(event.reference || event.data?.reference || event.client_reference || '')
+    const transactionId = String(event.transaction_id || event.data?.transaction_id || '') || null
+
+    if (reference.startsWith('school-payment:')) {
+      const paymentId = reference.slice('school-payment:'.length)
+      if (status === 'succeeded') {
+        const {data: payment} = await admin
+          .from('school_payments')
+          .select('id,user_id,amount_xof,status')
+          .eq('id', paymentId)
+          .maybeSingle()
+        await admin
+          .from('school_payments')
+          .update({status: 'succeeded', saspay_transaction_id: transactionId, paid_at: new Date().toISOString()})
+          .eq('id', paymentId)
+        await bestEffort(
+          admin
+            .from('transactions')
+            .update({status: 'succeeded', provider_transaction_id: transactionId})
+            .eq('payment_id', paymentId)
+            .eq('status', 'initiated'),
+        )
+        if (payment && String(payment.status) !== 'succeeded') {
+          const child = await loadChild(admin, String(payment.user_id))
+          const reference2 = receiptReference(paymentId)
+          // Le reçu est régénéré à la demande ; cette ligne trace sa création pour l'école.
+          await bestEffort(
+            admin
+              .from('payment_receipts')
+              .insert({
+                payment_id: paymentId,
+                reference: reference2,
+                issued_to: payment.user_id,
+                amount_xof: Number(payment.amount_xof) || 0,
+                student_name: child?.full_name || null,
+                school_name: child?.school_name || null,
+              }),
+          )
+          // Notification parent : l'alerte « reçu disponible » s'appuie sur cette table.
+          await bestEffort(
+            admin
+              .from('parent_notifications')
+              .insert({
+                user_id: payment.user_id,
+                kind: 'payment_receipt',
+                title: 'Reçu disponible',
+                body: `${child?.full_name || 'Votre enfant'} — ${reference2} (${new Intl.NumberFormat('fr-FR').format(Number(payment.amount_xof) || 0)} FCFA)`,
+              }),
+          )
+        }
+      } else if (status === 'failed') {
+        await admin
+          .from('school_payments')
+          .update({status: 'failed', saspay_transaction_id: transactionId})
+          .eq('id', paymentId)
+          .eq('status', 'pending')
+      }
+    }
+
+    return res.status(200).json({received: true, event_id: eventId || null, status})
+  } catch (error: any) {
+    return res.status(500).json({error: error?.message || 'Webhook processing error'})
+  }
+}
+
+export default withSecurity('/api/saspay/webhook', handler)
diff --git a/api/simen/export.ts b/api/simen/export.ts
new file mode 100644
index 0000000..fac8ba1
--- /dev/null
+++ b/api/simen/export.ts
@@ -0,0 +1,95 @@
+import { env } from '../../server/env.js'
+import type { VercelRequest, VercelResponse } from '@vercel/node'
+import { createClient } from '@supabase/supabase-js'
+
+import { withSecurity } from '../../server/security.js'
+import { buildSimenRows, CSV_BOM, simenCsv } from '../../server/simen.js'
+
+function json(res: VercelResponse, status: number, body: unknown) {
+  return res.status(status).json(body)
+}
+
+/**
+ * GET /api/simen/export
+ * Export Miroir « Conformité SIMEN » : fichier CSV structuré selon le modèle ministériel
+ * (IEN, code élève, nom, classe, moyenne, absences, retards), à importer en masse dans
+ * PLANETE 3.0 — zéro double saisie pour le directeur.
+ */
+async function handler(req: VercelRequest, res: VercelResponse) {
+  if (req.method !== 'GET') return json(res, 405, {error: 'Method not allowed'})
+  if (!env('SUPABASE_URL') || !env('SUPABASE_PUBLISHABLE_KEY') || !env('SUPABASE_SECRET_KEY')) {
+    return json(res, 503, {error: 'Supabase serveur non configuré.'})
+  }
+
+  const auth = String(req.headers.authorization || '')
+  const token = auth.startsWith('Bearer ') ? auth.slice(7) : ''
+  if (!token) return json(res, 401, {error: 'Authentification requise.'})
+
+  try {
+    const userClient = createClient(env('SUPABASE_URL'), env('SUPABASE_PUBLISHABLE_KEY'), {global: {headers: {Authorization: `Bearer ${token}`}}})
+    const admin = createClient(env('SUPABASE_URL'), env('SUPABASE_SECRET_KEY'))
+    const {data: {user}, error: userError} = await userClient.auth.getUser(token)
+    if (userError || !user) return json(res, 401, {error: 'Session invalide ou expirée.'})
+
+    const {data: profile} = await admin.from('profiles').select('id,role,school_id').eq('id', user.id).single()
+    if (!profile || profile.role !== 'director' || !profile.school_id) {
+      return json(res, 403, {error: 'Seul le directeur peut générer l’export de conformité.'})
+    }
+    const schoolId = String(profile.school_id)
+
+    const {data: school} = await admin.from('schools').select('id,name,ien').eq('id', schoolId).maybeSingle()
+    const ien = String(school?.ien || '')
+    if (!ien) return json(res, 409, {error: 'Identifiant IEN manquant : renseignez-le pour activer l’export SIMEN.'})
+
+    const {data: students, error: studentsError} = await admin
+      .from('profiles')
+      .select('id,full_name,student_code,class_members(class_id,classes(name))')
+      .eq('school_id', schoolId)
+      .eq('role', 'student')
+      .limit(2000)
+    if (studentsError) return json(res, 500, {error: 'Impossible de lire les élèves.'})
+
+    const ids = (students || []).map((student: any) => String(student.id))
+    let averages: Record<string, {sum: number; coef: number}> = {}
+    let attendance: Record<string, {absences: number; retards: number}> = {}
+    if (ids.length) {
+      const {data: grades} = await admin.from('grades').select('student_id,value').in('student_id', ids).limit(5000)
+      for (const grade of grades || []) {
+        const acc = (averages[String(grade.student_id)] ??= {sum: 0, coef: 0})
+        acc.sum += Number(grade.value) || 0
+        acc.coef += 1
+      }
+      const {data: events} = await admin.from('attendance_events').select('child_id,status').in('child_id', ids).limit(5000)
+      for (const event of events || []) {
+        const acc = (attendance[String(event.child_id)] ??= {absences: 0, retards: 0})
+        if (event.status === 'absent') acc.absences++
+        else if (event.status === 'late') acc.retards++
+      }
+    }
+
+    const rows = buildSimenRows((students || []).map((student: any) => {
+      const acc = averages[String(student.id)]
+      const att = attendance[String(student.id)]
+      return {
+        ien_etablissement: ien,
+        code_eleve: student.student_code || null,
+        nom_prenoms: student.full_name,
+        classe: student.class_members?.[0]?.classes?.name || null,
+        moyenne: acc && acc.coef > 0 ? acc.sum / acc.coef : null,
+        absences: att?.absences || 0,
+        retards: att?.retards || 0,
+      }
+    }))
+
+    const csv = CSV_BOM + simenCsv(rows)
+    const quarter = `T${Math.floor(new Date().getMonth() / 3) + 1}`
+    res.setHeader('Content-Type', 'text/csv; charset=utf-8')
+    res.setHeader('Cache-Control', 'no-store')
+    res.setHeader('Content-Disposition', `attachment; filename="conformite-simen-${quarter}.csv"`)
+    return res.status(200).send(csv)
+  } catch (error: any) {
+    return json(res, 500, {error: error?.message || 'L’export SIMEN n’a pas pu être généré.'})
+  }
+}
+
+export default withSecurity('/api/simen/export', handler)
