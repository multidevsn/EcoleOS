diff --git a/server/receipt-pdf.ts b/server/receipt-pdf.ts
new file mode 100644
index 0000000..ac6d61b
--- /dev/null
+++ b/server/receipt-pdf.ts
@@ -0,0 +1,142 @@
+/**
+ * Génération du reçu de paiement au format PDF, sans dépendance externe.
+ *
+ * Pourquoi une implification maison : un reçu scolaire tient sur une page, ne contient
+ * que du texte, et ajouter une bibliothèque PDF au bundle serverless coûte plus cher
+ * (taille, cold start) que les ~120 lignes ci-dessous. Le format produit est du PDF 1.4
+ * avec les polices de base Helvetica / Helvetica-Bold et l'encodage WinAnsi, ce qui
+ * couvre les accents français.
+ *
+ * Le fichier est volontairement pur (aucun import) : il est couvert par un test qui
+ * vérifie l'en-tête, la table xref et le contenu texte.
+ */
+
+export interface ReceiptLine {
+  label: string
+  value: string
+}
+
+export interface ReceiptPdfInput {
+  /** En-tête, ex. « École OS — Reçu de paiement ». */
+  title: string
+  /** Sous-titre, ex. le nom de l'établissement. */
+  subtitle?: string
+  /** Référence du reçu, ex. `REC-2026-000123`. */
+  reference: string
+  /** Lignes du corps du reçu. */
+  lines: ReceiptLine[]
+  /** Montant mis en évidence. */
+  amountLabel: string
+  /** Pied de page (mentions, contact de l'établissement…). */
+  footer?: string
+}
+
+const PAGE_WIDTH = 595
+const PAGE_HEIGHT = 842
+const MARGIN = 56
+
+/** Remplace les caractères non couverts par WinAnsi (typographie française courante). */
+function toWinAnsi(input: string): string {
+  const map: Record<string, string> = {
+    '\u2019': "'", '\u2018': "'", '\u201c': '"', '\u201d': '"',
+    '\u2013': '-', '\u2014': '-', '\u2026': '...', '\u00a0': '\u00a0',
+    // Intl.NumberFormat('fr-FR') sépare les milliers avec une espace fine insécable
+    // (U+202F) absente de WinAnsi : sans cette conversion, « 45 000 FCFA » s'imprimait
+    // « 45?000 FCFA ».
+    '\u202f': '\u00a0', '\u2009': '\u00a0', '\u2028': ' ',
+    '\u20ac': ' EUR', '\u0153': 'oe', '\u0152': 'OE',
+  }
+  let out = ''
+  for (const char of String(input ?? '')) {
+    const code = char.codePointAt(0) ?? 0
+    if (map[char]) out += map[char]
+    else if (code <= 0xff) out += char
+    else out += '?'
+  }
+  return out
+}
+
+/** Échappe les caractères spéciaux d'une chaîne littérale PDF. */
+function escapeText(input: string): string {
+  return toWinAnsi(input).replace(/\\/g, '\\\\').replace(/\(/g, '\\(').replace(/\)/g, '\\)')
+}
+
+/** Longueur en octets une fois encodé en Latin-1 (1 caractère = 1 octet). */
+function latin1Bytes(input: string): string {
+  return toWinAnsi(input)
+}
+
+function truncate(input: string, max: number): string {
+  const text = toWinAnsi(input)
+  return text.length > max ? `${text.slice(0, max - 1)}…`.slice(0, max) : text
+}
+
+/**
+ * Construit le contenu du PDF et renvoie les octets du fichier complet.
+ * Les offsets de la table xref sont calculés sur le flux Latin-1 réel.
+ */
+export function buildReceiptPdf(input: ReceiptPdfInput): Uint8Array {
+  const parts: string[] = []
+  let y = PAGE_HEIGHT - 90
+
+  const title = truncate(input.title || 'Reçu de paiement', 60)
+  parts.push(`BT /F2 18 Tf 1 0 0 1 ${MARGIN} ${y} Tm (${escapeText(title)}) Tj ET`)
+  y -= 22
+  if (input.subtitle) {
+    parts.push(`BT /F1 11 Tf 1 0 0 1 ${MARGIN} ${y} Tm (${escapeText(truncate(input.subtitle, 80))}) Tj ET`)
+    y -= 16
+  }
+  parts.push(`BT /F1 10 Tf 1 0 0 1 ${MARGIN} ${y} Tm (${escapeText(`Référence : ${truncate(input.reference, 40)}`)}) Tj ET`)
+  y -= 8
+  // Filet de séparation.
+  parts.push(`0.85 G ${MARGIN} ${y - 8} m ${PAGE_WIDTH - MARGIN} ${y - 8} l S`)
+  y -= 34
+
+  for (const line of input.lines) {
+    parts.push(`BT /F1 10 Tf 1 0 0 1 ${MARGIN} ${y} Tm (${escapeText(truncate(line.label, 42))}) Tj ET`)
+    parts.push(`BT /F1 10 Tf 1 0 0 1 ${PAGE_WIDTH - MARGIN - 220} ${y} Tm (${escapeText(truncate(line.value, 46))}) Tj ET`)
+    y -= 20
+  }
+
+  y -= 10
+  parts.push(`0.85 G ${MARGIN} ${y} m ${PAGE_WIDTH - MARGIN} ${y} l S`)
+  y -= 28
+  parts.push(`BT /F2 14 Tf 1 0 0 1 ${MARGIN} ${y} Tm (${escapeText(truncate(input.amountLabel, 40))}) Tj ET`)
+  y -= 46
+
+  parts.push(`BT /F1 9 Tf 1 0 0 1 ${MARGIN} ${y} Tm (${escapeText(truncate(input.footer || 'Document généré automatiquement par École OS.', 92))}) Tj ET`)
+  y -= 14
+  parts.push(`BT /F1 9 Tf 1 0 0 1 ${MARGIN} ${y} Tm (${escapeText(`Édité le ${new Date().toISOString().slice(0, 10)}`)}) Tj ET`)
+
+  const content = `${parts.join('\n')}\n`
+  const contentBytes = latin1Bytes(content)
+
+  const objects: string[] = [
+    '<< /Type /Catalog /Pages 2 0 R >>',
+    '<< /Type /Pages /Kids [3 0 R] /Count 1 >>',
+    `<< /Type /Page /Parent 2 0 R /MediaBox [0 0 ${PAGE_WIDTH} ${PAGE_HEIGHT}] /Resources << /Font << /F1 5 0 R /F2 6 0 R >> >> /Contents 4 0 R >>`,
+    `<< /Length ${contentBytes.length} >>\nstream\n${contentBytes}endstream`,
+    '<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica /Encoding /WinAnsiEncoding >>',
+    '<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica-Bold /Encoding /WinAnsiEncoding >>',
+  ]
+
+  let pdf = '%PDF-1.4\n'
+  const offsets: number[] = []
+  objects.forEach((body, index) => {
+    offsets.push(latin1Bytes(pdf).length)
+    pdf += `${index + 1} 0 obj\n${body}\nendobj\n`
+  })
+  const xrefOffset = latin1Bytes(pdf).length
+  pdf += `xref\n0 ${objects.length + 1}\n0000000000 65535 f \n`
+  for (const offset of offsets) pdf += `${String(offset).padStart(10, '0')} 00000 n \n`
+  pdf += `trailer\n<< /Size ${objects.length + 1} /Root 1 0 R >>\nstartxref\n${xrefOffset}\n%%EOF\n`
+
+  const bytes = new Uint8Array(pdf.length)
+  for (let i = 0; i < pdf.length; i++) bytes[i] = pdf.charCodeAt(i) & 0xff
+  return bytes
+}
+
+/** Formate un montant en francs CFA, comme dans le reste de l'application. */
+export function formatXof(amount: number): string {
+  return `${new Intl.NumberFormat('fr-FR').format(Number(amount) || 0)} FCFA`
+}
