@@ -0,0 +1,66 @@
+/**
+ * Relances de scolarité (Ecole.Online / plan SasPay, « Flux Techniques »).
+ *
+ * Le 5 de chaque mois, un cron Vercel (`/api/billing/reminders`) appelle
+ * `buildPaymentReminders()` sur les échéances encore ouvertes : chaque parent d'un
+ * élève en impayé reçoit une notification avec un lien de paiement unique SasPay.
+ *
+ * La logique de sélection est pure et testée : la route ne fait que lire la base et
+ * écrire les notifications.
+ */
+import { localDay } from './local-day.js'
+
+export interface PaymentReminderInput {
+  payment_id: string
+  child_id: string
+  child_name: string
+  school_name: string | null
+  parent_id: string
+  description: string
+  amount_xof: number
+  due_date: string | null
+  status: string
+}
+
+export interface PaymentReminder extends PaymentReminderInput {
+  /** Échéance dont la date est dépassée. */
+  overdue: boolean
+  /** Lien de paiement unique, à insérer dans l'alerte SMS/push. */
+  payment_link: string
+}
+
+/**
+ * Retourne les relances à émettre : uniquement les échéances non soldées, jamais les
+ * échéances réglées ou expirées. Une échéance réglée ne doit plus jamais relancer un
+ * parent.
+ */
+export function buildPaymentReminders(rows: PaymentReminderInput[], base: string, today = new Date()): PaymentReminder[] {
+  const day = localDay(today)
+  const reminders: PaymentReminder[] = []
+  for (const row of rows) {
+    if (row.status !== 'pending') continue
+    const overdue = Boolean(row.due_date) && String(row.due_date) < day
+    reminders.push({
+      ...row,
+      overdue,
+      payment_link: paymentLink(base, row.payment_id),
+    })
+  }
+  // Les arriérés d'abord : ce sont eux que le directeur veut récupérer en priorité.
+  return reminders.sort((a, b) => Number(b.overdue) - Number(a.overdue))
+}
+
+/** Libellé d'alerte court, en français, pour SMS/push. */
+export function reminderMessage(reminder: PaymentReminder): string {
+  const who = reminder.child_name || 'votre enfant'
+  const amount = new Intl.NumberFormat('fr-FR').format(Number(reminder.amount_xof) || 0)
+  return reminder.overdue
+    ? `${reminder.school_name || 'L’école'} : ${amount} FCFA d'arriérés pour ${who}. Réglez en un clic : ${reminder.payment_link}`
+    : `${reminder.school_name || 'L’école'} : échéance de ${amount} FCFA pour ${who} (${reminder.description}). Réglez en un clic : ${reminder.payment_link}`
+}
+
+/** Lien de paiement unique par échéance. */
+export function paymentLink(base: string, paymentId: string): string {
+  const root = String(base || '').replace(/\/+$/, '')
+  return `${root}/payer/${encodeURIComponent(paymentId)}`
+}
