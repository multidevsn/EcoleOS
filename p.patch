diff --git a/api/billing/reminders.ts b/api/billing/reminders.ts
new file mode 100644
index 0000000..7fe85d5
--- /dev/null
+++ b/api/billing/reminders.ts
@@ -0,0 +1,81 @@
+import { env } from '../../server/env.js'
+import type { VercelRequest, VercelResponse } from '@vercel/node'
+import { createClient } from '@supabase/supabase-js'
+
+import { withSecurity } from '../../server/security.js'
+import { buildPaymentReminders, reminderMessage } from '../../server/reminders.js'
+import { appUrl, loadChild } from '../../server/school-payments.js'
+
+function json(res: VercelResponse, status: number, body: unknown) {
+  return res.status(status).json(body)
+}
+
+/**
+ * POST|GET /api/billing/reminders
+ * Cron mensuel (5 du mois, voir vercel.json) : pour chaque échéance non soldée, notifie
+ * le ou les parents rattachés avec un lien de paiement SasPay unique.
+ *
+ * Idempotent : une clé `reminder:<paiement>:<mois>` unique empêche de relancer deux fois
+ * la même échéance dans le même mois.
+ */
+async function handler(req: VercelRequest, res: VercelResponse) {
+  if (req.method !== 'POST' && req.method !== 'GET') return json(res, 405, {error: 'Method not allowed'})
+  if (!env('SUPABASE_URL') || !env('SUPABASE_SECRET_KEY')) return json(res, 503, {error: 'Supabase secret server key non configurée.'})
+
+  const admin = createClient(env('SUPABASE_URL'), env('SUPABASE_SECRET_KEY'))
+  const base = appUrl(req.headers.host as string | undefined)
+
+  try {
+    const {data: payments, error} = await admin
+      .from('school_payments')
+      .select('id,user_id,description,amount_xof,status,due_date')
+      .eq('status', 'pending')
+      .order('due_date', {ascending: true})
+      .limit(500)
+    if (error) return json(res, 500, {error: 'Impossible de lire les échéances.'})
+
+    let notified = 0
+    for (const payment of payments || []) {
+      const child = await loadChild(admin, String(payment.user_id))
+      const {data: links} = await admin
+        .from('parent_students')
+        .select('parent_id')
+        .eq('student_id', payment.user_id)
+        .limit(5)
+      if (!links?.length) continue
+
+      const inputs = (links || []).map((link: any) => ({
+        payment_id: String(payment.id),
+        child_id: String(payment.user_id),
+        child_name: child?.full_name || 'Votre enfant',
+        school_name: child?.school_name || null,
+        parent_id: String(link.parent_id),
+        description: String(payment.description || 'Échéance de scolarité'),
+        amount_xof: Number(payment.amount_xof) || 0,
+        due_date: payment.due_date ? String(payment.due_date) : null,
+        status: String(payment.status || 'pending'),
+      }))
+
+      for (const reminder of buildPaymentReminders(inputs, base)) {
+        const month = new Date().toISOString().slice(0, 7)
+        const dedupe = `reminder:${reminder.payment_id}:${month}`
+        const {error: insertError} = await admin
+          .from('parent_notifications')
+          .insert({
+            user_id: reminder.parent_id,
+            kind: 'payment_reminder',
+            title: reminder.overdue ? 'Scolarité : arriérés à régulariser' : 'Scolarité : échéance à régler',
+            body: reminderMessage(reminder),
+            dedupe_key: dedupe,
+          })
+        if (!insertError) notified++
+      }
+    }
+
+    return json(res, 200, {ok: true, notifications: notified, paiements_ouverts: (payments || []).length})
+  } catch (error: any) {
+    return json(res, 500, {error: error?.message || 'Les relances n’ont pas pu être émises.'})
+  }
+}
+
+export default withSecurity('/api/billing/reminders', handler)
