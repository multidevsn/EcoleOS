+++ b/server/school-payments.ts
@@ -0,0 +1,125 @@
+/**
+ * Accès aux échéances scolaires côté serveur.
+ *
+ * Point clé de l'espace parent : une échéance appartient à l'ÉLÈVE
+ * (`school_payments.user_id = student_id`), mais c'est souvent le PARENT qui la règle.
+ * Un parent ne peut donc payer que les échéances d'un enfant réellement rattaché à son
+ * compte via `parent_students` — jamais celles d'un autre élève.
+ */
+import { env } from './env.js'
+
+export interface PayableChild {
+  id: string
+  full_name: string
+  class_name: string | null
+  school_name: string | null
+}
+
+export interface PayablePayment {
+  id: string
+  user_id: string
+  description: string
+  amount_xof: number
+  status: string
+  due_date: string | null
+}
+
+export interface PaymentAccess {
+  payment: PayablePayment
+  /** `true` quand le payeur est un parent et non l'élève lui-même. */
+  asParent: boolean
+  child: PayableChild | null
+}
+
+/**
+ * Exécute une écriture Supabase « de confort » (audit, journal, notification) sans jamais
+ * faire échouer la requête principale : une table absente ou une contrainte en échec ne
+ * doit pas empêcher un parent de payer ou de récupérer son reçu.
+ * Les builders Supabase sont des thenables et non des Promises : d'où Promise.resolve.
+ */
+export async function bestEffort(builder: any): Promise<void> {
+  try {
+    await Promise.resolve(builder)
+  } catch {
+    /* toléré volontairement */
+  }
+}
+
+/**
+ * Renvoie l'échéance si l'utilisateur a le droit de la régler, sinon `null`.
+ * `admin` est un client Supabase avec la clé secrète : la vérification d'appartenance est
+ * faite ici, jamais laissée au client.
+ */
+export async function findPayablePayment(admin: any, userId: string, paymentId: string): Promise<PaymentAccess | null> {
+  if (!userId || !paymentId) return null
+  const { data: row, error } = await admin
+    .from('school_payments')
+    .select('id,user_id,description,amount_xof,status,due_date')
+    .eq('id', paymentId)
+    .maybeSingle()
+  if (error || !row) return null
+
+  const asParent = String(row.user_id) !== String(userId)
+  if (asParent) {
+    // Le payeur doit être un parent rattaché à cet élève.
+    const { data: link, error: linkError } = await admin
+      .from('parent_students')
+      .select('parent_id,student_id')
+      .eq('parent_id', userId)
+      .eq('student_id', row.user_id)
+      .maybeSingle()
+    if (linkError || !link) return null
+  }
+
+  const child = await loadChild(admin, String(row.user_id))
+  return {
+    payment: {
+      id: String(row.id),
+      user_id: String(row.user_id),
+      description: String(row.description || 'Échéance de scolarité'),
+      amount_xof: Number(row.amount_xof) || 0,
+      status: String(row.status || 'pending'),
+      due_date: row.due_date ? String(row.due_date) : null,
+    },
+    asParent,
+    child,
+  }
+}
+
+/** Nom, classe et établissement d'un élève, pour libeller un reçu. */
+export async function loadChild(admin: any, studentId: string): Promise<PayableChild | null> {
+  if (!studentId) return null
+  const { data: profile } = await admin
+    .from('profiles')
+    .select('id,full_name,student_code,school_id,class_members(class_id,classes(name))')
+    .eq('id', studentId)
+    .maybeSingle()
+  if (!profile) return null
+  const schoolId = (profile as any).school_id
+  let schoolName: string | null = null
+  if (schoolId) {
+    const { data: school } = await admin.from('schools').select('id,name').eq('id', schoolId).maybeSingle()
+    schoolName = school?.name ? String(school.name) : null
+  }
+  const memberships = (profile as any).class_members || []
+  return {
+    id: String((profile as any).id),
+    full_name: String((profile as any).full_name || 'Élève'),
+    class_name: memberships?.[0]?.classes?.name ? String(memberships[0].classes.name) : null,
+    school_name: schoolName,
+  }
+}
+
+/**
+ * Numéro de reçu déterministe et lisible : `REC-<année>-<6 derniers caractères de l'id>`.
+ * Déterministe = le même paiement redonne toujours le même reçu (pas de doublon).
+ */
+export function receiptReference(paymentId: string): string {
+  const suffix = String(paymentId || '').replace(/-/g, '').slice(-6).toUpperCase()
+  return `REC-${new Date().getFullYear()}-${suffix}`
+}
+
+/** URL publique de l'application, pour les callbacks prestataires. */
+export function appUrl(fallbackHost?: string): string {
+  return env('APP_URL') || (fallbackHost ? `https://${fallbackHost}` : '')
+}
