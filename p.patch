new file mode 100644
index 0000000..f0b77c5
--- /dev/null
+++ b/tests/parent-ledger.test.ts
@@ -0,0 +1,85 @@
+import {describe, expect, it} from 'vitest'
+import {localDay, normalizeSenegalPhone, paymentLedger, upcomingHomework} from '../src/appModel'
+import type {HomeworkEntry, Payment} from '../src/appModel'
+
+const day = (offset: number) => localDay(new Date(Date.now() + offset * 86_400_000))
+
+const payments: Payment[] = [
+  {id: 'paid', description: 'Scolarité septembre', amount_xof: 30000, status: 'succeeded', due_date: day(-40)},
+  {id: 'arrears', description: 'Scolarité octobre', amount_xof: 30000, status: 'pending', due_date: day(-12)},
+  {id: 'current', description: 'Scolarité novembre', amount_xof: 30000, status: 'pending', due_date: day(9)},
+  {id: 'expired', description: 'Frais annulés', amount_xof: 99000, status: 'expired', due_date: day(-60)},
+]
+
+describe('paymentLedger — trésorerie affichée au parent', () => {
+  it('sépare payé, à venir et arriérés', () => {
+    const ledger = paymentLedger(payments)
+    expect(ledger.paid_xof).toBe(30000)
+    expect(ledger.arrears_xof).toBe(30000)
+    expect(ledger.due_xof).toBe(30000)
+    expect(ledger.coverage).toBe('late')
+  })
+
+  it('propose la prochaine échéance la plus proche, pas la plus ancienne', () => {
+    const ledger = paymentLedger(payments)
+    expect(ledger.next?.id).toBe('arrears')
+  })
+
+  it('ignore une échéance expirée dans les totaux', () => {
+    const ledger = paymentLedger(payments)
+    expect(ledger.paid_xof + ledger.due_xof + ledger.arrears_xof).toBe(90000)
+  })
+
+  it('déclare « à jour » quand tout est réglé', () => {
+    const ledger = paymentLedger([{id: 'a', description: 'Scolarité', amount_xof: 25000, status: 'succeeded', due_date: day(-5)}])
+    expect(ledger.coverage).toBe('up_to_date')
+    expect(ledger.next).toBeNull()
+    expect(ledger.arrears_xof).toBe(0)
+  })
+
+  it('déclare « partiel » quand seule une échéance future reste', () => {
+    const ledger = paymentLedger([
+      {id: 'a', description: 'Scolarité', amount_xof: 25000, status: 'succeeded', due_date: day(-30)},
+      {id: 'b', description: 'Scolarité', amount_xof: 25000, status: 'pending', due_date: day(10)},
+    ])
+    expect(ledger.coverage).toBe('partial')
+  })
+
+  it('supporte une liste vide sans NaN', () => {
+    const ledger = paymentLedger([])
+    expect(ledger).toMatchObject({paid_xof: 0, due_xof: 0, arrears_xof: 0, coverage: 'up_to_date'})
+  })
+})
+
+describe('upcomingHomework — cahier de textes', () => {
+  const entries: HomeworkEntry[] = [
+    {id: 'late', child_id: 'c', subject: 'Maths', title: 'Exercices 4 à 8', due_date: day(-2)},
+    {id: 'tomorrow', child_id: 'c', subject: 'Français', title: 'Rédaction', due_date: day(1)},
+    {id: 'far', child_id: 'c', subject: 'Anglais', title: 'Vocabulaire', due_date: day(20)},
+    {id: 'done', child_id: 'c', subject: 'SVT', title: 'Compte rendu', due_date: day(2), done: true},
+  ]
+
+  it('place d’abord ce qui est en retard, puis les 7 prochains jours, puis la suite', () => {
+    expect(upcomingHomework(entries).map(entry => entry.id)).toEqual(['late', 'tomorrow', 'far'])
+  })
+
+  it('écarte les devoirs déjà faits', () => {
+    expect(upcomingHomework(entries).some(entry => entry.id === 'done')).toBe(false)
+  })
+})
+
+describe('normalizeSenegalPhone — numéro demandé pour payer', () => {
+  it('accepte les formats courants et rend de l’E.164', () => {
+    expect(normalizeSenegalPhone('77 123 45 67')).toBe('+221771234567')
+    expect(normalizeSenegalPhone('0771234567')).toBe('+221771234567')
+    expect(normalizeSenegalPhone('221771234567')).toBe('+221771234567')
+    expect(normalizeSenegalPhone('+221771234567')).toBe('+221771234567')
+  })
+
+  it('refuse un numéro qui ne peut pas recevoir le paiement', () => {
+    expect(normalizeSenegalPhone('12345')).toBeNull()
+    expect(normalizeSenegalPhone('338001212')).toBeNull()
+    expect(normalizeSenegalPhone('')).toBeNull()
+    expect(normalizeSenegalPhone('+2217712')).toBeNull()
+  })
+})
