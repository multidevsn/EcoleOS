+++ b/server/simen.ts
@@ -0,0 +1,85 @@
+/**
+ * Export Miroir « Conformité SIMEN » (Ecole.Online / plan, section 3).
+ *
+ * L'État (PLANETE 3.0, apps.education.sn) n'expose pas d'API publique : le directeur
+ * télécharge donc un fichier structuré selon le modèle ministériel et l'importe en une
+ * seule fois (import de masse), sans double saisie.
+ *
+ * Format retenu ici : CSV séparé par `;` avec BOM UTF-8, ouvrable directement dans Excel
+ * en français. La génération du `.xlsx` « au bit près » (Mois 3 de la feuille de route)
+ * réutilisera exactement les mêmes lignes (`buildSimenRows`) : seule la sérialisation
+ * changera.
+ */
+
+export interface SimenInput {
+  ien_etablissement: string
+  code_eleve: string | null
+  nom_prenoms: string
+  classe: string | null
+  moyenne: number | null
+  absences: number
+  retards: number
+}
+
+export interface SimenRow {
+  IEN_ETABLISSEMENT: string
+  CODE_ELEVE: string
+  NOM_PRENOMS: string
+  CLASSE: string
+  MOYENNE_T1: string
+  NB_ABSENCES: string
+  NB_RETARDS: string
+  STATUT: string
+}
+
+export const SIMEN_COLUMNS: (keyof SimenRow)[] = [
+  'IEN_ETABLISSEMENT',
+  'CODE_ELEVE',
+  'NOM_PRENOMS',
+  'CLASSE',
+  'MOYENNE_T1',
+  'NB_ABSENCES',
+  'NB_RETARDS',
+  'STATUT',
+]
+
+/** Normalise une ligne d'élève au format attendu par le modèle ministériel. */
+export function toSimenRow(input: SimenInput): SimenRow {
+  return {
+    IEN_ETABLISSEMENT: String(input.ien_etablissement || '').toUpperCase(),
+    CODE_ELEVE: String(input.code_eleve || ''),
+    NOM_PRENOMS: String(input.nom_prenoms || '').toUpperCase(),
+    CLASSE: String(input.classe || ''),
+    MOYENNE_T1: moyenneFix(input.moyenne),
+    NB_ABSENCES: String(Math.max(0, Math.round(Number(input.absences) || 0))),
+    NB_RETARDS: String(Math.max(0, Math.round(Number(input.retards) || 0))),
+    STATUT: 'INSCRIT',
+  }
+}
+
+function moyenneFix(value: number | null): string {
+  if (value == null || !Number.isFinite(Number(value))) return ''
+  // Le modèle ministériel attend une note sur 20 à deux décimales, séparateur virgule.
+  return Number(value).toFixed(2).replace('.', ',')
+}
+
+export function buildSimenRows(rows: SimenInput[]): SimenRow[] {
+  return rows.map(toSimenRow).sort((a, b) => a.NOM_PRENOMS.localeCompare(b.NOM_PRENOMS, 'fr'))
+}
+
+/** Échappe une cellule CSV (séparateur `;`). */
+function csvCell(value: string): string {
+  const text = String(value ?? '')
+  if (/[;"\n\r]/.test(text)) return `"${text.replace(/"/g, '""')}"`
+  return text
+}
+
+/** Sérialise les lignes en CSV `;` (sans BOM : l'ajout du BOM est fait par la route). */
+export function simenCsv(rows: SimenRow[]): string {
+  const header = SIMEN_COLUMNS.join(';')
+  const body = rows.map(row => SIMEN_COLUMNS.map(col => csvCell(row[col])).join(';'))
+  return [header, ...body].join('\r\n')
+}
+
+/** BOM UTF-8 pour qu'Excel ouvre le CSV avec les accents corrects. */
+export const CSV_BOM = '﻿'
