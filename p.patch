+import React,{useMemo,useState} from 'react'
+import {
+  attendanceLabels,
+  localDay,
+  money,
+  normalizeSenegalPhone,
+  paymentLedger,
+  upcomingHomework,
+} from './appModel'
+import type {AppData, AttendanceStatus, Child, PaymentMethod} from './appModel'
+import type {Mode} from './shared'
+import {Empty, KpiStrip, shortDate, shortMoney} from './shared'
+import {errorMessage} from './lib/errors'
+import {Baby, BellRing, CalendarCheck, CircleDollarSign, NotebookPen, ReceiptText, Smartphone, WalletCards, Waves} from 'lucide-react'
+
+/** Enfant actuellement suivi par le parent (le compte parent est unique). */
+export function activeChildOf(data: AppData): Child | null {
+  const children = data.children || []
+  if (!children.length) return null
+  return children.find(child => child.id === data.activeChildId) || children[0]
+}
+
+const methodLabels: Record<PaymentMethod, string> = {wave: 'Wave', orange_money: 'Orange Money'}
+
+const attendanceTone: Record<AttendanceStatus, string> = {present: 'ok', absent: 'late', late: 'pending'}
+
+/**
+ * Espace Parent (Ecole.Online)
+ * Trois priorités, dans l'ordre du cahier des charges :
+ *   1. la trésorerie de l'enfant suivi (payé / en cours / arriérés) et son paiement,
+ *   2. le cahier de textes numérique,
+ *   3. les absences et retards signalés à l'appel.
+ * Tout est cadré sur `data.activeChildId` : basculer d'enfant ne change pas de compte.
+ */
+export function ParentSpace({mode, data, session}: {mode: Mode; data: AppData; session: any}) {
+  const child = activeChildOf(data)
+  const ledger = useMemo(() => paymentLedger(data.payments), [data.payments])
+  const homework = useMemo(() => upcomingHomework(data.homework || []), [data.homework])
+  const attendance = data.attendance || []
+  const today = localDay()
+  const [method, setMethod] = useState<PaymentMethod>('wave')
+  const [phone, setPhone] = useState('')
+  const [busy, setBusy] = useState(false)
+  const [msg, setMsg] = useState('')
+  const [notice, setNotice] = useState('')
+  const [error, setError] = useState<unknown>(null)
+  const [demoReceipt, setDemoReceipt] = useState<{reference: string; amount_xof: number; label: string; date: string} | null>(null)
+
+  const amountDue = Number(ledger.next?.amount_xof || 0)
+  const absences = attendance.filter(event => event.status !== 'present')
+
+  async function pay() {
+    const next = ledger.next
+    if (!next) {
+      setNotice('Aucune échéance à régler pour cet enfant.')
+      return
+    }
+    const normalized = normalizeSenegalPhone(phone)
+    if (!normalized) {
+      setError(new Error('Numéro invalide : saisissez un mobile sénégalais à 9 chiffres, par exemple 77 123 45 67.'))
+      return
+    }
+    setError(null)
+    setNotice('')
+    setDemoReceipt(null)
+
+    if (mode === 'demo') {
+      setDemoReceipt({
+        reference: `DEMO-${String(Date.now()).slice(-6)}`,
+        amount_xof: Number(next.amount_xof) || 0,
+        label: next.description,
+        date: today,
+      })
+      setNotice('Paiement simulé : aucun débit réel et aucun reçu envoyé en mode démo.')
+      return
+    }
+
+    const token = session?.access_token
+    if (!token) {
+      setError(new Error('Session expirée : reconnectez-vous pour payer.'))
+      return
+    }
+    setBusy(true)
+    setMsg('Ouverture de SasPay…')
+    try {
+      const res = await fetch('/api/saspay/checkout', {
+        method: 'POST',
+        headers: {'Content-Type': 'application/json', Authorization: `Bearer ${token}`},
+        body: JSON.stringify({type: 'school_payment', payment_id: next.id, method, phone: normalized}),
+      })
+      const result = await res.json()
+      if (!res.ok) throw new Error(errorMessage(result.error || `HTTP ${res.status}`, 'Le paiement SasPay n’a pas pu être créé.'))
+      // SasPay renvoie soit une URL de validation (USSD/web), soit une demande push
+      // à confirmer directement sur le téléphone du parent.
+      if (result.redirect_url) window.location.href = result.redirect_url
+      else setMsg('Demande envoyée : validez la transaction sur votre téléphone, puis revenez ici.')
+    } catch (caught: any) {
+      setError(caught)
+    } finally {
+      setBusy(false)
+      setMsg('')
+    }
+  }
+
+  const receiptHref = (paymentId: string) => `/api/saspay/receipt?payment_id=${encodeURIComponent(paymentId)}`
+
+  /** Le reçu est protégé par la session : on le récupère avec le jeton, puis on l'ouvre. */
+  async function downloadReceipt(paymentId: string) {
+    if (mode === 'demo') {
+      setNotice('Mode démo : aucun reçu PDF n’est généré.')
+      return
+    }
+    const token = session?.access_token
+    if (!token) {
+      setError(new Error('Session expirée : reconnectez-vous pour télécharger le reçu.'))
+      return
+    }
+    setError(null)
+    setNotice('')
+    try {
+      const res = await fetch(receiptHref(paymentId), {headers: {Authorization: `Bearer ${token}`}})
+      if (!res.ok) {
+        const result = await res.json().catch(() => null)
+        throw new Error(errorMessage(result?.error || `HTTP ${res.status}`, 'Le reçu n’a pas pu être généré.'))
+      }
+      const url = URL.createObjectURL(await res.blob())
+      window.open(url, '_blank', 'noopener')
+      setTimeout(() => URL.revokeObjectURL(url), 60_000)
+    } catch (caught: any) {
+      setError(caught)
+    }
+  }
+
+  return <>
+    <div className="section-intro parent-intro">
+      <div>
+        <span className="eyebrow">Espace parent{child ? ` · ${child.school_name}` : ''}</span>
+        <h1>{child ? child.full_name : 'Votre enfant'}</h1>
+        <p>{child?.class_name ? `${child.class_name} · ` : ''}Trésorerie, cahier de textes et présence, au même endroit.</p>
+      </div>
+      {child?.student_code && <span className="parent-code">{child.student_code}</span>}
+    </div>
+
+    <div className={'ledger-banner ' + ledger.coverage}>
+      <CircleDollarSign size={28}/>
+      <div>
+        <b>{ledger.coverage === 'late' ? 'Arriérés à régulariser' : ledger.coverage === 'partial' ? 'Scolarité en cours' : 'Scolarité à jour'}</b>
+        <span>
+          {ledger.coverage === 'late'
+            ? `${money(ledger.arrears_xof)} d’arriérés · prochaine échéance ${ledger.next ? shortDate(ledger.next.due_date) : '—'}`
+            : ledger.next
+              ? `Prochaine échéance · ${shortDate(ledger.next.due_date)}`
+              : 'Aucune échéance en attente'}
+        </span>
+      </div>
+      <strong>{shortMoney(ledger.coverage === 'late' ? ledger.arrears_xof : amountDue)}</strong>
+    </div>
+
+    <KpiStrip items={[
+      {label: 'Scolarité payée', value: shortMoney(ledger.paid_xof), meta: 'Échéances réglées', icon: <WalletCards size={16}/>, },
+      {label: 'Mois en cours', value: shortMoney(ledger.due_xof), meta: ledger.next ? `Échéance ${shortDate(ledger.next.due_date)}` : 'À jour', icon: <CalendarCheck size={16}/>},
+      {label: 'Arriérés', value: shortMoney(ledger.arrears_xof), meta: ledger.arrears_xof > 0 ? 'À régulariser' : 'Aucun retard', icon: <BellRing size={16}/>},
+    ]}/>
+
+    <section className="panel saspay-panel">
+      <div className="panel-head">
+        <h3>Payer avec SasPay</h3>
+        <small>Wave ou Orange Money · reçu PDF immédiat</small>
+      </div>
+      {ledger.next ? <>
+        <div className="saspay-amount">
+          <span>{ledger.next.description}</span>
+          <strong>{money(Number(ledger.next.amount_xof) || 0)}</strong>
+        </div>
+        <div className="saspay-methods" role="group" aria-label="Moyen de paiement">
+          {(Object.keys(methodLabels) as PaymentMethod[]).map(key => (
+            <button type="button" key={key} className={method === key ? 'selected' : ''} aria-pressed={method === key} onClick={() => setMethod(key)}>
+              {key === 'wave' ? <Waves size={16}/> : <Smartphone size={16}/>}{methodLabels[key]}
+            </button>
+          ))}
+        </div>
+        <label className="saspay-phone">Numéro {methodLabels[method]}
+          <input value={phone} onChange={event => setPhone(event.target.value)} inputMode="tel" autoComplete="tel" placeholder="77 123 45 67" aria-label={`Numéro ${methodLabels[method]}`}/>
+        </label>
+        <button className="primary full" onClick={pay} disabled={busy || !amountDue}>
+          {busy ? 'Ouverture…' : `Payer ${shortMoney(amountDue)} avec ${methodLabels[method]}`}
+        </button>
+        {mode === 'demo' && <p className="saspay-note">Mode démo : la transaction est simulée, aucun débit réel n’est effectué.</p>}
+      </> : <Empty text="Aucune échéance en attente : la scolarité de cet enfant est réglée."/>}
+      {msg && <div className="alert">{msg}</div>}
+      {notice && <div className="alert success">{notice}</div>}
+      {error ? <div className="alert error">{errorMessage(error, 'Le paiement n’a pas abouti.')}</div> : null}
+      {demoReceipt && <div className="receipt-card" role="status">
+        <ReceiptText size={20}/>
+        <div>
+          <b>Reçu {demoReceipt.reference}</b>
+          <span>{demoReceipt.label} · {money(demoReceipt.amount_xof)} · {shortDate(demoReceipt.date)}</span>
+          <small>En mode réel, ce reçu est généré en PDF et envoyé par notification dès la confirmation SasPay.</small>
+        </div>
+      </div>}
+    </section>
+
+    <section className="panel">
+      <div className="panel-head"><h3>Échéancier</h3><small>{data.payments.length} échéance(s)</small></div>
+      {data.payments.length ? data.payments.map(payment => (
+        <div className="payment-row" key={payment.id}>
+          <span>{payment.description}<small>{shortDate(payment.due_date)}</small></span>
+          <b>{money(Number(payment.amount_xof) || 0)}</b>
+          <small className={payment.status === 'succeeded' ? 'ok' : payment.status === 'pending' ? 'pending' : 'late'}>
+            {payment.status === 'succeeded' ? 'Payé' : payment.status === 'failed' ? 'Échec' : payment.status === 'expired' ? 'Expiré' : payment.due_date < today ? 'En retard' : 'À payer'}
+          </small>
+          {payment.status === 'succeeded'
+            ? <button className="text-btn" onClick={() => downloadReceipt(payment.id)}>Reçu PDF</button>
+            : <span className="text-btn" aria-hidden="true">—</span>}
+        </div>
+      )) : <Empty text="Aucune échéance enregistrée."/>}
+    </section>
+
+    <section className="panel">
+      <div className="panel-head"><h3><NotebookPen size={16}/> Cahier de textes</h3><small>{homework.length} devoir(s) à faire</small></div>
+      {homework.length ? homework.map(entry => (
+        <div className={'homework-row' + (entry.due_date < today ? ' overdue' : entry.due_date === today ? ' today' : '')} key={entry.id}>
+          <div>
+            <b>{entry.title}</b>
+            <span>{entry.subject}{entry.details ? ` · ${entry.details}` : ''}</span>
+          </div>
+          <em>{entry.due_date < today ? `Rendu dépassé · ${shortDate(entry.due_date)}` : entry.due_date === today ? 'Pour aujourd’hui' : `Pour le ${shortDate(entry.due_date)}`}</em>
+        </div>
+      )) : <Empty text="Aucun devoir à faire pour le moment."/>}
+    </section>
+
+    <section className="panel">
+      <div className="panel-head"><h3>Présence</h3><small>{absences.length} signalement(s)</small></div>
+      {attendance.length ? attendance.map(event => (
+        <div className="attendance-row" key={event.id}>
+          <span className={'dot ' + attendanceTone[event.status]}/>
+          <span>{shortDate(event.date)}{event.period ? ` · ${event.period}` : ''}</span>
+          <small className={attendanceTone[event.status]}>{attendanceLabels[event.status]}</small>
+        </div>
+      )) : <Empty text="Aucun appel enregistré."/>}
+      {absences.length > 0 && <div className="alert">Vous êtes prévenu dès qu’un agent saisit une absence ou un retard à l’appel.</div>}
+    </section>
+
+    <section className="panel">
+      <div className="panel-head"><h3>Dernières notes</h3><small>{data.grades.length} note(s)</small></div>
+      {data.grades.slice(0, 5).map(grade => (
+        <div className="grade-row" key={grade.id} style={{'--v': grade.value / 20} as React.CSSProperties}>
+          <span>{grade.subject}</span>
+          <small>Coef. {grade.coefficient} · {grade.term}</small>
+          <b>{grade.value}/20</b>
+        </div>
+      ))}
+      {!data.grades.length && <Empty text="Aucune note saisie pour le moment."/>}
+    </section>
+
+    <p className="parent-switcher-hint"><Baby size={15}/> Vous suivez {data.children?.length || 1} enfant(s) depuis ce compte unique : changez d’enfant dans le menu de gauche, sans vous reconnecter.</p>
+  </>
+}
