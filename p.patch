+import {describe, expect, it} from 'vitest'
+import {roleFromSession} from '../src/appModel'
+
+// Un compte connecté ne doit jamais être rétrogradé en « Élève » par défaut :
+// c'est ce qui faisait qu'un directeur inscrit devenait un élève côté interface.
+describe('roleFromSession', () => {
+  it('lit le rôle réel dans les métadonnées Auth', () => {
+    expect(roleFromSession({user: {user_metadata: {role: 'director'}}})).toBe('director')
+    expect(roleFromSession({user: {user_metadata: {role: 'cafeteria'}}})).toBe('cafeteria')
+    expect(roleFromSession({user: {user_metadata: {role: 'parent'}}})).toBe('parent')
+  })
+
+  it('renvoie null plutôt qu’un rôle inventé quand la métadonnée manque ou est invalide', () => {
+    expect(roleFromSession({user: {user_metadata: {role: 'superadmin'}}})).toBeNull()
+    expect(roleFromSession({user: {user_metadata: {role: ''}}})).toBeNull()
+    expect(roleFromSession({user: {user_metadata: {role: 'constructor'}}})).toBeNull()
+    expect(roleFromSession({user: {user_metadata: {}}})).toBeNull()
+    expect(roleFromSession({user: {}})).toBeNull()
+    expect(roleFromSession({})).toBeNull()
+    expect(roleFromSession(null)).toBeNull()
+    expect(roleFromSession(undefined)).toBeNull()
+  })
+})
diff --git a/tests/saspay.test.ts b/tests/saspay.test.ts
new file mode 100644
index 0000000..8e17e07
--- /dev/null
+++ b/tests/saspay.test.ts
@@ -0,0 +1,99 @@
+import {createHmac} from 'node:crypto'
+import {describe, expect, it} from 'vitest'
+import {
+  describeSasPayError,
+  normalizeSasPayMethod,
+  normalizeSenegalPhone,
+  saspayConfigError,
+  saspayEventStatus,
+  verifySasPaySignature,
+} from '../server/saspay'
+
+describe('normalizeSasPayMethod', () => {
+  it('n’accepte que Wave et Orange Money', () => {
+    expect(normalizeSasPayMethod('wave')).toBe('wave')
+    expect(normalizeSasPayMethod('WAVE')).toBe('wave')
+    expect(normalizeSasPayMethod('orange_money')).toBe('orange_money')
+    expect(normalizeSasPayMethod('Orange Money')).toBe('orange_money')
+    expect(normalizeSasPayMethod('om')).toBe('orange_money')
+  })
+
+  it('refuse tout le reste plutôt que d’envoyer un moyen de paiement inconnu', () => {
+    expect(normalizeSasPayMethod('paypal')).toBeNull()
+    expect(normalizeSasPayMethod('')).toBeNull()
+    expect(normalizeSasPayMethod(undefined)).toBeNull()
+    expect(normalizeSasPayMethod({})).toBeNull()
+  })
+})
+
+describe('normalizeSenegalPhone (côté serveur)', () => {
+  it('produit le même E.164 que le client', () => {
+    expect(normalizeSenegalPhone('77 123 45 67')).toBe('+221771234567')
+    expect(normalizeSenegalPhone('0771234567')).toBe('+221771234567')
+    expect(normalizeSenegalPhone('338001212')).toBeNull()
+  })
+})
+
+describe('saspayConfigError', () => {
+  it('explique en français ce qui manque quand SasPay n’est pas activé', () => {
+    const message = saspayConfigError()
+    expect(message).toBeTruthy()
+    expect(message).toContain('SASPAY_API_BASE')
+    expect(message).toContain('Aucun débit')
+  })
+})
+
+describe('describeSasPayError — aucun détail brut renvoyé à la famille', () => {
+  it('traduit les codes d’erreur courants', () => {
+    expect(describeSasPayError(402, {message: 'insufficient_funds'})).toContain('refusé')
+    expect(describeSasPayError(409, {})).toContain('déjà en cours')
+    expect(describeSasPayError(429, {})).toContain('patientez')
+    expect(describeSasPayError(503, {message: 'upstream_timeout'})).toContain('momentanément indisponible')
+  })
+
+  it('ne recopie pas le message technique du prestataire sur une panne serveur', () => {
+    expect(describeSasPayError(500, {message: 'NullPointerException at SasPaySDK line 42'})).not.toContain('NullPointerException')
+  })
+
+  it('garde le détail utile pour une erreur de saisie', () => {
+    expect(describeSasPayError(422, {message: 'Le numéro saisi n’est pas un numéro Wave.'})).toContain('Wave')
+  })
+})
+
+describe('saspayEventStatus', () => {
+  it('reconnaît l’état quel que soit le champ retenu par le prestataire', () => {
+    expect(saspayEventStatus({status: 'succeeded'})).toBe('succeeded')
+    expect(saspayEventStatus({data: {payment_status: 'paid'}})).toBe('succeeded')
+    expect(saspayEventStatus({status: 'failed'})).toBe('failed')
+    expect(saspayEventStatus({status: 'unknown_state'})).toBe('pending')
+  })
+})
+
+describe('verifySasPaySignature — callback non signé = refusé', () => {
+  const secret = 'secret-de-test'
+  const body = '{"id":"evt_1","status":"succeeded","reference":"school-payment:abc"}'
+  const sign = (payload: string, timestamp: number) =>
+    createHmac('sha256', secret).update(String(timestamp) + payload).digest('hex')
+
+  it('accepte une signature HMAC correcte et récente', async () => {
+    const timestamp = Math.floor(Date.now() / 1000)
+    expect(await verifySasPaySignature(body, `t=${timestamp},v1=${sign(body, timestamp)}`, secret)).toBe(true)
+  })
+
+  it('refuse un corps modifié après signature', async () => {
+    const timestamp = Math.floor(Date.now() / 1000)
+    const header = `t=${timestamp},v1=${sign(body, timestamp)}`
+    expect(await verifySasPaySignature(body.replace('succeeded', 'failed'), header, secret)).toBe(false)
+  })
+
+  it('refuse un horodatage trop ancien (rejeu)', async () => {
+    const timestamp = Math.floor(Date.now() / 1000) - 3600
+    expect(await verifySasPaySignature(body, `t=${timestamp},v1=${sign(body, timestamp)}`, secret)).toBe(false)
+  })
+
+  it('refuse une signature absente ou un secret absent', async () => {
+    expect(await verifySasPaySignature(body, '', secret)).toBe(false)
+    expect(await verifySasPaySignature(body, 't=1,v1=deadbeef', secret)).toBe(false)
+    expect(await verifySasPaySignature(body, 't=1,v1=deadbeef', '')).toBe(false)
+  })
+})
