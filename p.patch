+/** Récapitulatif de trésorerie affiché en tête de l'espace parent. */
+export type LedgerSummary={
+  /** Somme des échéances déjà réglées. */
+  paid_xof:number
+  /** Somme des échéances à venir (non encore exigibles). */
+  due_xof:number
+  /** Somme des échéances dont la date est dépassée et non réglées. */
+  arrears_xof:number
+  /** Prochaine échéance à régler, si elle existe. */
+  next:Payment|null
+  /** État global : à jour, partiellement réglé, ou en retard. */
+  coverage:'up_to_date'|'partial'|'late'
+}
+
+/**
+ * Calcule le récapitulatif de trésorerie d'un enfant à partir de ses échéances.
+ * Fonction pure : c'est elle qui décide ce que le parent voit (« à jour »,
+ * « arriérés »), donc elle est couverte par des tests.
+ */
+export function paymentLedger(payments:Payment[], today=new Date()):LedgerSummary{
+  const day=localDay(today)
+  let paid_xof=0
+  let due_xof=0
+  let arrears_xof=0
+  for(const payment of payments){
+    const amount=Number(payment.amount_xof)||0
+    if(payment.status==='succeeded'){paid_xof+=amount;continue}
+    if(payment.status==='expired')continue
+    if(payment.status==='pending'&&payment.due_date&&payment.due_date<day)arrears_xof+=amount
+    else due_xof+=amount
+  }
+  const next=payments
+    .filter(payment=>payment.status==='pending')
+    .sort((a,b)=>String(a.due_date).localeCompare(String(b.due_date)))[0]||null
+  const coverage:LedgerSummary['coverage']=arrears_xof>0?'late':due_xof>0?'partial':'up_to_date'
+  return {paid_xof,due_xof,arrears_xof,next,coverage}
+}
+
+/** `YYYY-MM-DD` en heure locale : les échéances scolaires sont des dates civiles. */
+export function localDay(date=new Date()):string{
+  return `${date.getFullYear()}-${String(date.getMonth()+1).padStart(2,'0')}-${String(date.getDate()).padStart(2,'0')}`
+}
+
+/** Devoirs à rendre : d'abord ceux du jour et des 7 prochains jours, puis le reste. */
+export function upcomingHomework(entries:HomeworkEntry[], today=new Date()):HomeworkEntry[]{
+  const day=localDay(today)
+  const horizon=new Date(today)
+  horizon.setDate(horizon.getDate()+7)
+  const end=localDay(horizon)
+  const open=entries.filter(entry=>!entry.done)
+  const soon=open.filter(entry=>entry.due_date>=day&&entry.due_date<=end)
+  const later=open.filter(entry=>entry.due_date>end)
+  const past=open.filter(entry=>entry.due_date<day)
+  const byDate=(a:HomeworkEntry,b:HomeworkEntry)=>a.due_date.localeCompare(b.due_date)
+  return [...past.sort(byDate),...soon.sort(byDate),...later.sort(byDate)]
+}
+
+/** Normalise un numéro de téléphone sénégalais en format international E.164. */
+export function normalizeSenegalPhone(raw:string):string|null{
+  const digits=String(raw||'').replace(/[^\d+]/g,'')
+  if(!digits)return null
+  if(digits.startsWith('+221'))return digits.length===13?digits:null
+  const national=digits.replace(/^00221/,'').replace(/^221/,'').replace(/^0/,'')
+  // Indicatifs mobiles : 70, 75, 76, 77, 78 (Orange/Free/Expresso), 71/72 (Wave/autres).
+  if(national.length!==9||!/^7\d{8}$/.test(national))return null
+  return `+221${national}`
+}
