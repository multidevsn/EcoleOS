{
  "name": "ecole-os",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:api",
    "build:android": "tsc -b && vite build --mode android && npm run build:api",
    "preview": "vite preview",
    "build:api": "tsc -p tsconfig.api.json --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@supabase/supabase-js": "^2.57.4",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vercel/node": "^5.4.1",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.0.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": "24.x"
  },
  "allowScripts": {
    "esbuild@0.27.0": true,
    "esbuild@0.21.5": true
  }
}
